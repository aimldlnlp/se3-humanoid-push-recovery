<mujoco model="mini_humanoid">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" iterations="80" solver="Newton"/>
  <visual>
    <global offwidth="1920" offheight="1080"/>
    <headlight ambient="0.42 0.45 0.50" diffuse="0.78 0.80 0.84" specular="0.18 0.20 0.24"/>
    <quality shadowsize="2048" offsamples="4"/>
  </visual>
  <size njmax="200" nconmax="80"/>
  <default>
    <joint damping="1.0" armature="0.02" limited="true"/>
    <geom friction="0.7 0.1 0.02" solref="0.004 1" solimp="0.9 0.95 0.001"/>
    <motor ctrllimited="true" ctrlrange="-180 180" gear="1"/>
  </default>
  <asset>
    <texture name="sky_tex" type="skybox" builtin="gradient" width="512" height="512" rgb1="0.96 0.97 0.99" rgb2="0.78 0.84 0.91"/>
    <texture name="floor_tex" type="2d" builtin="checker" width="256" height="256" rgb1="0.73 0.76 0.80" rgb2="0.88 0.89 0.91"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="7 7" reflectance="0.04"/>
    <material name="body_mat" rgba="0.08 0.31 0.62 1"/>
    <material name="joint_mat" rgba="0.82 0.29 0.07 1"/>
    <material name="foot_mat" rgba="0.02 0.48 0.35 1"/>
  </asset>
  <worldbody>
    <geom name="ground" type="plane" size="8 8 0.1" material="floor_mat" contype="1" conaffinity="1"/>
    <camera name="track" mode="targetbody" target="pelvis" pos="2.2 -3.0 1.6" fovy="36"/>
    <body name="pelvis" pos="0 0 1.04999">
      <freejoint name="root"/>
      <geom name="pelvis_geom" type="box" pos="0 0 0" size="0.20 0.14 0.12" material="body_mat" mass="7"/>
      <body name="torso" pos="0 0 0.22">
        <geom name="torso_geom" type="box" pos="0 0 0.23" size="0.24 0.16 0.24" material="body_mat" mass="12"/>
        <body name="head" pos="0 0 0.55">
          <geom name="head_geom" type="sphere" size="0.11" material="joint_mat" mass="2"/>
        </body>
      </body>
      <body name="left_thigh" pos="0 0.11 -0.12">
        <joint name="left_hip_pitch" type="hinge" axis="1 0 0" range="-1.5 1.5"/>
        <joint name="left_hip_roll" type="hinge" axis="0 1 0" range="-0.7 0.7"/>
        <geom name="left_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.095" material="joint_mat" mass="4"/>
        <body name="left_shin" pos="0 0 -0.42">
          <joint name="left_knee" type="hinge" axis="1 0 0" range="-2.4 0.1"/>
          <geom name="left_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.075" material="joint_mat" mass="3"/>
          <body name="left_foot" pos="0 0 -0.42">
            <joint name="left_ankle_pitch" type="hinge" axis="1 0 0" range="-1.0 1.0"/>
            <geom name="left_foot_geom" type="box" pos="0.055 0 -0.045" size="0.17 0.12 0.045" material="foot_mat" mass="1.5"/>
          </body>
        </body>
      </body>
      <body name="right_thigh" pos="0 -0.11 -0.12">
        <joint name="right_hip_pitch" type="hinge" axis="1 0 0" range="-1.5 1.5"/>
        <joint name="right_hip_roll" type="hinge" axis="0 1 0" range="-0.7 0.7"/>
        <geom name="right_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.095" material="joint_mat" mass="4"/>
        <body name="right_shin" pos="0 0 -0.42">
          <joint name="right_knee" type="hinge" axis="1 0 0" range="-2.4 0.1"/>
          <geom name="right_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.075" material="joint_mat" mass="3"/>
          <body name="right_foot" pos="0 0 -0.42">
            <joint name="right_ankle_pitch" type="hinge" axis="1 0 0" range="-1.0 1.0"/>
            <geom name="right_foot_geom" type="box" pos="0.055 0 -0.045" size="0.17 0.12 0.045" material="foot_mat" mass="1.5"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="left_hip_pitch_motor" joint="left_hip_pitch" ctrlrange="-180 180"/>
    <motor name="left_hip_roll_motor" joint="left_hip_roll" ctrlrange="-180 180"/>
    <motor name="left_knee_motor" joint="left_knee" ctrlrange="-180 180"/>
    <motor name="left_ankle_pitch_motor" joint="left_ankle_pitch" ctrlrange="-180 180"/>
    <motor name="right_hip_pitch_motor" joint="right_hip_pitch" ctrlrange="-180 180"/>
    <motor name="right_hip_roll_motor" joint="right_hip_roll" ctrlrange="-180 180"/>
    <motor name="right_knee_motor" joint="right_knee" ctrlrange="-180 180"/>
    <motor name="right_ankle_pitch_motor" joint="right_ankle_pitch" ctrlrange="-180 180"/>
  </actuator>
</mujoco>
